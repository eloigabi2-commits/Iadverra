DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iadverra?schema=public"

# Opcional: fixa o período dos Dados Abertos CNPJ a importar (padrão: mais recente disponível)
# RFB_PERIOD=2026-06

# Opcional: importa só as empresas destes CNAEs (códigos separados por vírgula)
# RFB_CNAE_FILTER=6201500,4711302

# Google Ads API (OAuth). No ambiente cloud, configure em "Editar ambiente" — nunca commite os valores.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=2955725842

# Envio de documentos (/documentos/<token>) e painel das consultoras (/painel)
# PAINEL_SENHA=           # senha do gestor (vê todas as atendentes); trocar derruba todas as sessões
#                         # cada atendente entra pelo link pessoal dela (/a/<chave>), em /painel/atendentes
# DOCUMENTOS_API_KEY=     # chave que a IA/n8n usa em POST /api/solicitacoes
# APP_URL=https://seu-dominio.com.br   # base dos links enviados ao cliente
# NOME_ESCRITORIO=Nome do Escritório
# CONTATO_PRIVACIDADE=privacidade@seu-dominio.com.br
# INWORLD_API_KEY=        # só para scripts/gerar-audios.ts (voz das falas do envio de documentos)

# Instagram (/instagram): o login é feito dentro do app. A senha não é gravada; os
# cookies da sessão ficam criptografados no banco com esta chave. Use uma string
# longa e aleatória; trocá-la desconecta todas as sessões salvas.
# INSTAGRAM_SESSION_KEY=

# Cobranças reais (/pagar/<codigo>): Pix e cartão pela API do Asaas.
# A chave fica em Asaas > Integrações > Chave de API. Nunca commite os valores.
# ASAAS_API_KEY=
# ASAAS_SANDBOX=true        # use o sandbox do Asaas em testes
# ASAAS_WEBHOOK_TOKEN=      # mesmo token configurado no webhook do Asaas
# ASAAS_BASE_URL=https://api-sandbox.asaas.com   # opcional; sobrepõe ASAAS_SANDBOX

# Portal de crédito do cliente (/credito): entra com nome, e-mail e WhatsApp, e
# cada "adicionar fundos" avisa o n8n e abre uma cobrança do Asaas.
# CREDITO_SESSAO_KEY=       # string longa e aleatória; sem ela, usa PAINEL_SENHA
# CREDITO_WEBHOOK_URL=https://n8n.srv1288686.hstgr.cloud/webhook/credito

# Opcional: só para a extensão "Instagram Ponte" (instagram-ponte/) e o upload do
# .zip de "Seguidores e seguindo". O fluxo principal não precisa disso.
# APP_URL=https://seu-dominio.com.br
