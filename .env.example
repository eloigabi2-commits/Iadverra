DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iadverra?schema=public"

# Opcional: fixa o período dos Dados Abertos CNPJ a importar (padrão: mais recente disponível)
# RFB_PERIOD=2026-06

# Opcional: importa só as empresas destes CNAEs (códigos separados por vírgula)
# RFB_CNAE_FILTER=6201500,4711302

# Caminho local do binário rbx-studio-mcp (Roblox Studio MCP Server), usado pelo
# servidor MCP "Roblox_Studio" em .mcp.json. Só funciona rodando o Claude
# (Desktop ou Code) na MESMA máquina onde o Roblox Studio está instalado —
# veja "Integração com Roblox Studio (MCP)" no README.
# Windows: C:\Caminho\para\rbx-studio-mcp.exe
# macOS:   /Applications/RobloxStudioMCP.app/Contents/MacOS/rbx-studio-mcp
# ROBLOX_STUDIO_MCP_PATH=
