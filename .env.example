DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iadverra?schema=public"

# Opcional: fixa o período dos Dados Abertos CNPJ a importar (padrão: mais recente disponível)
# RFB_PERIOD=2026-06

# Opcional: importa só as empresas destes CNAEs (códigos separados por vírgula)
# RFB_CNAE_FILTER=6201500,4711302

# Google Ads API (OAuth). No ambiente cloud, configure em "Editar ambiente" — nunca commite os valores.
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=2955725842

# Envio de documentos (/documentos/<token>) e painel das consultoras (/painel)
# PAINEL_SENHA=           # senha do painel; trocar derruba as sessões abertas
# DOCUMENTOS_API_KEY=     # chave que a IA/n8n usa em POST /api/solicitacoes
# APP_URL=https://seu-dominio.com.br   # base dos links enviados ao cliente
# NOME_ESCRITORIO=Nome do Escritório
# CONTATO_PRIVACIDADE=privacidade@seu-dominio.com.br
