DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iadverra?schema=public"

# Necessário para o assistente de IA do Fluxo de Caixa (Contabilidade Conforme)
# responder perguntas. Sem essa chave o assistente mostra um erro claro na UI
# em vez de travar o resto do app. Gere em https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional: fixa o período dos Dados Abertos CNPJ a importar (padrão: mais recente disponível)
# RFB_PERIOD=2026-06

# Opcional: importa só as empresas destes CNAEs (códigos separados por vírgula)
# RFB_CNAE_FILTER=6201500,4711302
